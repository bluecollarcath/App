PORT=8787
JWT_SECRET=replace-with-a-long-random-string

# RevenueCat project settings -> API keys -> "Secret API key" (server-side, do not expose to clients)
REVENUECAT_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat project settings -> Integrations -> Webhooks -> Authorization header value you configure there
REVENUECAT_WEBHOOK_SECRET=replace-with-a-long-random-string

# RevenueCat entitlement identifier that unlocks premium content (default: "premium")
REVENUECAT_ENTITLEMENT_ID=premium

DATABASE_PATH=./data.sqlite
