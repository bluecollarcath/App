# Required: a long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
PORT=8787
DATABASE_PATH=./data.sqlite
# Public URL of the site (used for Stripe redirect URLs)
APP_URL=http://localhost:5173

# Stripe (leave blank to run in demo-billing mode during development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Set to true ONLY for local testing: lets "Subscribe" grant access without Stripe
ALLOW_DEMO_BILLING=true
