# ── Required in production ─────────────────────────────
# A long random string used to sign login tokens. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
# The public address of the site, with no trailing slash. Used in email links and Stripe redirects.
APP_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────
# Production: a PostgreSQL connection string (on Render, the database's "Internal Database URL").
DATABASE_URL=
# Set to false only if your Postgres host does not support TLS.
# DATABASE_SSL=false
# Local development (used when DATABASE_URL is empty): a SQLite file.
DATABASE_PATH=./data.sqlite

PORT=8787

# ── Email (password resets, support messages) ─────────
# API key from https://resend.com. Without it, emails are printed to the server log instead.
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend.
EMAIL_FROM=Ohmentum <no-reply@yourdomain.com>
# Where contact-form messages and lesson error reports are delivered.
SUPPORT_EMAIL=

# ── Stripe ─────────────────────────────────────────────
# Leave blank to run in demo-billing mode during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Set to true ONLY for local testing: lets "Subscribe" grant access without Stripe.
# Ignored when NODE_ENV=production.
ALLOW_DEMO_BILLING=true

# ── Owner access ───────────────────────────────────────
# Comma-separated emails that get every lesson free, with no subscription (you and staff).
# Create the account with this email yourself right away, so no one else can sign up with it.
OWNER_EMAILS=
